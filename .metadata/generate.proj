<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.Windows.WinmdGenerator/0.63.31-preview">
    <PropertyGroup>
        <OutputWinmd>../.windows/winmd/Microsoft.Win32.Graphics.Direct3DRM.winmd</OutputWinmd>
        <WinmdVersion>1.0.0.0</WinmdVersion>
        <LegacyRoot>..\.direct3drm\</LegacyRoot>
        <LegacyIncRoot>$(LegacyRoot)\include</LegacyIncRoot>
        <ExcludeFromCrossarch>Microsoft.Win32.Graphics.Direct3DRM</ExcludeFromCrossarch>
        <AdditionalIncludes>$(LegacyIncRoot)</AdditionalIncludes>
    </PropertyGroup>

    <ItemGroup>
        <EmitterRsp Include="emitter.rsp" />
    </ItemGroup>

    <ItemGroup>
        <Headers Include="$(LegacyIncRoot)\d3drm.h;$(LegacyIncRoot)\d3drmobj.h;$(LegacyIncRoot)\d3drmdef.h;..." />
        <Partition Include="main.cpp" >
            <TraverseFiles>@(Headers)</TraverseFiles>
            <Namespace>Microsoft.Win32.Graphics.Direct3DRM</Namespace>
        </Partition>
    </ItemGroup>
</Project>